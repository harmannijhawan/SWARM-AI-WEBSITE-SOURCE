# Server-only SWARM-managed provider keys. Users never supply provider credentials.
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
OPENAI_API_KEY=

# Exact approved provider:model allowlists; Premium models are Pro only.
SWARM_STANDARD_MODELS=groq:openai/gpt-oss-20b
SWARM_PREMIUM_MODELS=

# Server mode must match the credentials. Never use NEXT_PUBLIC_ for secrets.
CASHFREE_ENV=sandbox
# Production credentials used ONLY when CASHFREE_ENV=production.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# Sandbox credentials used ONLY when CASHFREE_ENV=sandbox.
CASHFREE_SANDBOX_CLIENT_ID=
CASHFREE_SANDBOX_CLIENT_SECRET=
SWARM_PUBLIC_URL=http://127.0.0.1:3000
# Webhook URL: <public backend origin>/api/billing/webhook
SWARM_PRO_PRICE_PAISE=69900
SWARM_PRO_ACCESS_DAYS=30
SWARM_ALLOWANCE_DAYS=30
SWARM_FREE_BUILDS=5
SWARM_FREE_CHATS=2
# Choose funded capacity after reviewing provider costs and bounded operations.
# Blank deliberately disables checkout and Pro inference.
SWARM_PRO_BUILDS=
SWARM_PRO_CHATS=
SWARM_PRO_CONCURRENCY=4
SWARM_HOURLY_REQUESTS=60
SWARM_NATIVE_BUILD_CALLS=32
SWARM_NATIVE_CHAT_CALLS=8

# Set both Clerk keys to enable user accounts when hosting.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PROXY_URL=
# Use a stable server secret in hosted environments.
SESSION_SECRET=
# Optional existing cloud API override. Leave empty to use the integrated backend.
SWARM_API_URL=
