# Local workspace works with provider keys already set in this computer environment.
# Optional provider credentials: configure in Settings or use environment variables.
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# NVIDIA_API_KEY=
