# Set both Clerk keys to enable user accounts when hosting.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PROXY_URL=
# Use a stable server secret in hosted environments.
SESSION_SECRET=
# Optional existing cloud API override. Leave empty to use the integrated backend.
SWARM_API_URL=
